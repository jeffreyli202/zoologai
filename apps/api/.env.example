# Copy to .env for local development:
#   Copy-Item .env.example .env

DATABASE_URL=sqlite:///./zoologai.db

# Private local folders (not served as a public static dump)
UPLOAD_DIR=./uploads/videos
FRAME_DIR=./uploads/frames

# 100 MB = 104857600 bytes
MAX_UPLOAD_BYTES=104857600

# Frame sampling: one still every N seconds, capped per video
FRAME_INTERVAL_SECONDS=15
MAX_FRAMES_PER_VIDEO=12
FRAME_MAX_DIMENSION=1280

# Google Gemini (backend only — never expose to the browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Max Gemini calls per "Analyze Video" background job
MAX_AI_CALLS_PER_VIDEO_JOB=12

# Authorized camera monitoring (snapshot URL or local sample folder)
CAMERA_CAPTURE_DIR=./uploads/camera_captures
MONITOR_SCHEDULER_TICK_SECONDS=30
MIN_MONITOR_INTERVAL_MINUTES=1
DEFAULT_MONITOR_INTERVAL_MINUTES=15
MONITOR_FETCH_TIMEOUT_SECONDS=20
MONITOR_MAX_IMAGE_BYTES=8388608

# Browser origins for the web UI (comma-separated). Include your Vercel URL
# and any custom domain. Localhost stays for `npm run dev`.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://YOUR_PROJECT.vercel.app
# Preview deployments (PR previews). Empty to disable: CORS_ORIGIN_REGEX=
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
