# ZooLog AI — environment variable template
# Copy values into the app-specific env files below.
# Do not commit real secrets.

# --- Frontend: copy into apps/web/.env.local ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend: copy into apps/api/.env ---
DATABASE_URL=sqlite:///./zoologai.db
UPLOAD_DIR=./uploads/videos
FRAME_DIR=./uploads/frames
MAX_UPLOAD_BYTES=104857600
FRAME_INTERVAL_SECONDS=15
MAX_FRAMES_PER_VIDEO=12
FRAME_MAX_DIMENSION=1280
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_AI_CALLS_PER_VIDEO_JOB=12
CAMERA_CAPTURE_DIR=./uploads/camera_captures
MONITOR_SCHEDULER_TICK_SECONDS=30
MIN_MONITOR_INTERVAL_MINUTES=1
DEFAULT_MONITOR_INTERVAL_MINUTES=15
