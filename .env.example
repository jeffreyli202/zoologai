# ZooLog AI — environment variable template
# Copy values into the app-specific env files below.
# Do not commit real secrets.

# --- Frontend: copy into apps/web/.env.local (local) ---
# On Vercel: set the same key in Project → Settings → Environment Variables
# to your public Oracle API URL, e.g. https://api.zoologai.example.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend: copy into apps/api/.env (local + Oracle VM) ---
DATABASE_URL=sqlite:///./zoologai.db
UPLOAD_DIR=./uploads/videos
FRAME_DIR=./uploads/frames
MAX_UPLOAD_BYTES=104857600
FRAME_INTERVAL_SECONDS=15
MAX_FRAMES_PER_VIDEO=12
FRAME_MAX_DIMENSION=1280
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_AI_CALLS_PER_VIDEO_JOB=12
CAMERA_CAPTURE_DIR=./uploads/camera_captures
MONITOR_SCHEDULER_TICK_SECONDS=30
MIN_MONITOR_INTERVAL_MINUTES=1
DEFAULT_MONITOR_INTERVAL_MINUTES=15
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://YOUR_PROJECT.vercel.app
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
# Optional on Oracle/cloud for YouTube live (Netscape cookies.txt; never commit)
# YTDLP_COOKIES=./youtube-cookies.txt
YTDLP_COOKIES=
