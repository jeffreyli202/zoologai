# --- Frontend (copy into apps/web/.env.local) ---
# Public API base URL used by the browser (must be prefixed with NEXT_PUBLIC_)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend (copy into apps/api/.env) ---
# SQLite file path relative to apps/api when you run uvicorn from that folder.
DATABASE_URL=sqlite:///./zoologai.db
